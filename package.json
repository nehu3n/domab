{
  "name": "domab",
  "version": "0.1.0",
  "description": "🧩 Tiny, dependency-free TypeScript toolkit for defining type-safe domain abstractions.",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "readme.md"
  ],
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "release": "pnpm build && pnpm exec changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm check && pnpm typecheck && pnpm test && pnpm build",
    "version": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "lefthook": "^2.1.14",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
